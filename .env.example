# --- AI provider (speech-to-text + scoring/feedback) ---
# Pick one: "openai" (paid) or "groq" (free tier, https://console.groq.com/keys).
# If empty: uses OpenAI when OPENAI_API_KEY is set, otherwise Groq when GROQ_API_KEY is set.
# Without a key for the chosen provider the app runs in demo mode (simulated AI results).
AI_PROVIDER=

OPENAI_API_KEY=
GROQ_API_KEY=

# Secret used to sign login cookies (any long random string).
SESSION_SECRET=

# Postgres connection string (Neon recommended on Vercel).
# Leave empty locally: the app then uses PGlite stored in ./.data/pglite.
DATABASE_URL=

# --- Optional ---
# OpenAI models (defaults: gpt-5.4-mini, whisper-1 which gives word timings for fluency)
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=
# Groq models (defaults: openai/gpt-oss-120b, whisper-large-v3-turbo which gives word timings)
GROQ_MODEL=
GROQ_TRANSCRIBE_MODEL=
# Vercel Blob token to keep recordings so teachers can listen again.
BLOB_READ_WRITE_TOKEN=
# Password for the auto-created demo accounts (default demo1234). Set this in production!
SEED_PASSWORD=
