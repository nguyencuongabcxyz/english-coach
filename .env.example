# --- Required in production ---
# OpenAI key used for speech-to-text and ChatGPT feedback.
# Without it the app runs in demo mode (simulated AI results).
OPENAI_API_KEY=

# Secret used to sign login cookies (any long random string).
SESSION_SECRET=

# Postgres connection string (Neon recommended on Vercel).
# Leave empty locally: the app then uses PGlite stored in ./.data/pglite.
DATABASE_URL=

# --- Optional ---
# ChatGPT model for scoring/feedback (default: gpt-5.4-mini)
OPENAI_MODEL=
# Speech-to-text model (default: whisper-1, which gives word timings for fluency)
OPENAI_TRANSCRIBE_MODEL=
# Vercel Blob token to keep recordings so teachers can listen again.
BLOB_READ_WRITE_TOKEN=
# Password for the auto-created demo accounts (default demo1234). Set this in production!
SEED_PASSWORD=
